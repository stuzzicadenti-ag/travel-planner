<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Dashboard - TravelPlanner</title>
  <link rel="icon" type="image/svg+xml" href="/public/favicon.svg">
  <link rel="stylesheet" href="/public/style.css">
  <style>
    .admin-layout { display: flex; min-height: 100vh; }
    .admin-sidebar { width: 240px; background: linear-gradient(180deg, #e8f4fd 0%, #d0e8f7 100%); border-right: 1px solid #cde0ed; display: flex; flex-direction: column; padding: 1.5rem 0; flex-shrink: 0; }
    .admin-sidebar__brand { padding: 0 1.25rem 1.5rem; border-bottom: 1px solid #cde0ed; text-align: center; }
    .admin-sidebar__brand .logo-icon { font-size: 1.5rem; }
    .admin-sidebar__title { display: block; font-size: 1.1rem; font-weight: 700; color: #2c3e50; margin-top: 0.25rem; }
    .admin-sidebar__subtitle { display: block; font-size: 0.75rem; color: #5a6d7e; text-transform: uppercase; letter-spacing: 0.05em; }
    .admin-sidebar__nav { flex: 1; padding: 1rem 0; }
    .admin-sidebar__link { display: flex; align-items: center; gap: 0.6rem; padding: 0.6rem 1.25rem; color: #2c3e50; font-size: 0.9rem; font-weight: 500; text-decoration: none; transition: background 0.15s; }
    .admin-sidebar__link:hover { background: rgba(58,155,213,0.12); color: #2a7ab5; }
    .admin-sidebar__link--active { background: rgba(58,155,213,0.18); color: #2a7ab5; font-weight: 600; border-right: 3px solid #3a9bd5; }
    .admin-sidebar__link--back { color: #5a6d7e; }
    .admin-sidebar__icon { font-size: 1.1rem; width: 1.4rem; text-align: center; }
    .admin-sidebar__footer { padding: 1rem 0; border-top: 1px solid #cde0ed; }
    .admin-main { flex: 1; padding: 2rem; background: #fafcfe; overflow-y: auto; }
    .admin-header { margin-bottom: 2rem; }
    .admin-header h1 { font-size: 1.75rem; font-weight: 700; color: #2c3e50; }
    .admin-header p { color: #5a6d7e; margin-top: 0.25rem; }
    .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1.25rem; margin-bottom: 2rem; }
    .stat-card { background: #fff; border: 1px solid #e8ecf1; border-radius: 12px; padding: 1.5rem; box-shadow: 0 2px 8px rgba(0,0,0,0.06); }
    .stat-card__label { font-size: 0.8rem; color: #5a6d7e; text-transform: uppercase; letter-spacing: 0.04em; font-weight: 600; }
    .stat-card__value { font-size: 2rem; font-weight: 800; color: #2c3e50; margin-top: 0.5rem; }
    .stat-card--alert .stat-card__value { color: #e74c3c; }
    .stat-card--accent { border-left: 4px solid #3a9bd5; }
    .stat-card--orange { border-left: 4px solid #f5a623; }
    .stat-card--green { border-left: 4px solid #27ae60; }
    @media (max-width: 768px) { .admin-layout { flex-direction: column; } .admin-sidebar { width: 100%; flex-direction: row; padding: 0.5rem; overflow-x: auto; } .admin-sidebar__brand { display: none; } .admin-sidebar__nav { display: flex; padding: 0; gap: 0.25rem; } .admin-sidebar__link { padding: 0.5rem 0.75rem; font-size: 0.8rem; white-space: nowrap; } .admin-sidebar__footer { display: none; } }
  </style>
</head>
<body>
  <div class="admin-layout">
    <% const activePage = 'dashboard'; %>
    <%- include('_sidebar') %>
    <div class="admin-main">
      <div class="admin-header">
        <h1>Dashboard</h1>
        <p>Welcome back, <%= user.name %>. Here is your platform overview.</p>
      </div>
      <div class="stats-grid">
        <div class="stat-card stat-card--accent">
          <div class="stat-card__label">Total Users</div>
          <div class="stat-card__value"><%= stats.users %></div>
        </div>
        <div class="stat-card stat-card--green">
          <div class="stat-card__label">Itineraries</div>
          <div class="stat-card__value"><%= stats.itineraries %></div>
        </div>
        <div class="stat-card stat-card--orange">
          <div class="stat-card__label">Saved Trips</div>
          <div class="stat-card__value"><%= stats.savedTrips %></div>
        </div>
        <div class="stat-card stat-card--accent">
          <div class="stat-card__label">Affiliate Clicks</div>
          <div class="stat-card__value"><%= stats.affiliateClicks %></div>
        </div>
        <div class="stat-card<%= stats.pendingFlags > 0 ? ' stat-card--alert' : '' %>">
          <div class="stat-card__label">Pending Flags</div>
          <div class="stat-card__value"><%= stats.pendingFlags %></div>
        </div>
      </div>
      <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
        <a href="/admin/users" class="btn btn-primary">Manage Users</a>
        <a href="/admin/flags" class="btn btn-orange">Review Flags</a>
        <a href="/admin/itineraries" class="btn btn-outline">View Itineraries</a>
        <a href="/admin/logs" class="btn btn-outline">Activity Logs</a>
      </div>
    </div>
  </div>
  <script>
  (function() {
    var token = '<%= typeof csrfToken !== "undefined" ? csrfToken : "" %>';
    if (!token) return;
    document.querySelectorAll('form[method="POST"], form[method="post"]').forEach(function(form) {
      if (form.querySelector('input[name="_csrf"]')) return;
      var input = document.createElement('input');
      input.type = 'hidden';
      input.name = '_csrf';
      input.value = token;
      form.appendChild(input);
    });
  })();
  </script>
</body>
</html>
