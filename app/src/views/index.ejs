<%- include('partials/header') %>

<!-- Hero Section -->
<section class="hero" id="hero">
  <div class="hero-bg">
    <div class="cloud cloud-1">&#9729;</div>
    <div class="cloud cloud-2">&#9729;</div>
    <div class="cloud cloud-3">&#9925;</div>
  </div>
  <div class="container hero-content">
    <h1 class="hero-title"><%= t('hero_title') %></h1>
    <p class="hero-subtitle"><%= t('hero_subtitle') %></p>
    <div class="hero-actions">
      <a href="/itineraries" class="btn btn-primary btn-lg"><%= t('hero_explore_trips') %></a>
      <a href="#how-it-works" class="btn btn-outline btn-lg"><%= t('hero_how_it_works') %></a>
    </div>
    <div class="hero-stats">
      <div class="stat">
        <span class="stat-number">50K+</span>
        <span class="stat-label"><%= t('hero_trips_planned') %></span>
      </div>
      <div class="stat">
        <span class="stat-number">120+</span>
        <span class="stat-label"><%= t('hero_destinations') %></span>
      </div>
      <div class="stat">
        <span class="stat-number">10K+</span>
        <span class="stat-label"><%= t('hero_travelers') %></span>
      </div>
    </div>
  </div>
</section>

<!-- Trust Bar -->
<section class="trust-bar">
  <div class="container">
    <div class="trust-items">
      <div class="trust-item">
        <span class="trust-icon">&#11088;</span>
        <span><%= t('trust_rating') %></span>
      </div>
      <div class="trust-item">
        <span class="trust-icon">&#128101;</span>
        <span><%= t('trust_trusted') %></span>
      </div>
      <div class="trust-item">
        <span class="trust-icon">&#128274;</span>
        <span><%= t('trust_cancellation') %></span>
      </div>
      <div class="trust-item">
        <span class="trust-icon">&#127760;</span>
        <span><%= t('trust_destinations') %></span>
      </div>
    </div>
  </div>
</section>

<!-- Filter Bar -->
<section class="section filter-section" id="filter-bar">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title"><%= t('filter_title') %></h2>
      <p class="section-subtitle"><%= t('filter_subtitle') %></p>
    </div>
    <div class="filter-pills-row">
      <span class="filter-pills-label"><%= t('filter_mood') %></span>
      <a href="/itineraries?mood=adventure" class="filter-pill">&#127956; <%= t('filter_adventure') %></a>
      <a href="/itineraries?mood=relaxation" class="filter-pill">&#127796; <%= t('filter_relaxation') %></a>
      <a href="/itineraries?mood=culture" class="filter-pill">&#127963; <%= t('filter_culture') %></a>
      <a href="/itineraries?mood=party" class="filter-pill">&#127881; <%= t('filter_party') %></a>
      <a href="/itineraries?mood=wellness" class="filter-pill">&#128518; <%= t('filter_wellness') %></a>
    </div>
    <div class="filter-pills-row" style="margin-top: 12px;">
      <span class="filter-pills-label"><%= t('filter_season') %></span>
      <a href="/itineraries?season=summer" class="filter-pill filter-pill--summer">&#9728; <%= t('filter_summer') %></a>
      <a href="/itineraries?season=winter" class="filter-pill filter-pill--winter">&#10052; <%= t('filter_winter') %></a>
      <a href="/itineraries?season=spring" class="filter-pill filter-pill--spring">&#127800; <%= t('filter_spring') %></a>
      <a href="/itineraries?season=autumn" class="filter-pill filter-pill--autumn">&#127810; <%= t('filter_autumn') %></a>
    </div>
  </div>
</section>

<!-- Last-Minute Deals -->
<% if (typeof deals !== 'undefined' && deals.length > 0) { %>
<section class="section deals-section" id="deals">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">&#128293; <%= t('deals_title') %></h2>
      <p class="section-subtitle"><%= t('deals_subtitle') %></p>
    </div>
    <div class="deals-grid">
      <% deals.forEach(function(deal) { %>
        <div class="deal-card">
          <div class="deal-card__img" style="background: <%= deal.cover_gradient || 'linear-gradient(135deg, #ffecd2, #fcb69f)' %>;">
            <span class="deal-card__emoji"><%- deal.country_code || '&#127758;' %></span>
            <span class="deal-badge">-<%= deal.discount %>%</span>
            <% if (deal.spots_left && deal.spots_left <= 5) { %>
              <span class="spots-badge spots-badge--pulse"><%= deal.spots_left %> <%= t('deals_spots_left') %></span>
            <% } else if (deal.spots_left) { %>
              <span class="spots-badge"><%= deal.spots_left %> <%= t('deals_spots_left_calm') %></span>
            <% } %>
          </div>
          <div class="deal-card__body">
            <h3 class="deal-card__title"><%= deal.title %></h3>
            <div class="deal-card__meta">
              <span>&#127758; <%= deal.destination %></span>
              <span>&#128197; <%= deal.duration_days %> <%= t('days') %></span>
              <% if (deal.age_range) { %><span>&#128100; <%= deal.age_range %></span><% } %>
            </div>
            <div class="deal-pricing">
              <% if (deal.original_price) { %>
                <span class="deal-original-price">&euro;<%= Number(deal.original_price).toLocaleString() %></span>
              <% } %>
              <span class="deal-current-price">&euro;<%= Number(deal.budget_amount).toLocaleString() %></span>
            </div>
            <% if (deal.departure_date) { %>
              <div class="deal-departure"><%= t('deals_departs') %> <%= new Date(deal.departure_date).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) %></div>
            <% } %>
            <a href="/itineraries/<%= deal.id %>" class="btn btn-primary btn-sm btn-block"><%= t('deals_view') %></a>
          </div>
        </div>
      <% }); %>
    </div>
  </div>
</section>
<% } %>

<!-- Trending Destinations (DB-driven) -->
<section class="section destinations" id="destinations">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title"><%= t('trending_title') %></h2>
      <p class="section-subtitle"><%= t('trending_subtitle') %></p>
    </div>
    <% if (itineraries && itineraries.length > 0) { %>
      <div class="destinations-grid">
        <% itineraries.forEach(function(itin) { %>
          <div class="destination-card">
            <div class="destination-img" style="background: <%= itin.coverGradient || 'linear-gradient(135deg, #e8f4fd, #b8ddf3)' %>;">
              <span class="destination-emoji"><%- itin.countryCode || '&#127758;' %></span>
              <% if (itin.discount && itin.discount > 0) { %>
                <span class="deal-badge deal-badge--card">-<%= itin.discount %>%</span>
              <% } %>
            </div>
            <div class="destination-body">
              <h3 class="destination-name"><%= itin.title %></h3>
              <div class="destination-rating">
                <span class="stars"><%- '&#9733;'.repeat(Math.round(Number(itin.rating) || 0)) %><%- '&#9734;'.repeat(5 - Math.round(Number(itin.rating) || 0)) %></span>
                <span class="rating-num"><%= itin.rating || '4.5' %></span>
              </div>
              <p class="destination-desc"><%= itin.description ? itin.description.substring(0, 100) + '...' : '' %></p>
              <div class="destination-meta">
                <span class="tag">&#128197; <%= itin.durationDays %> <%= t('days') %></span>
                <span class="tag">&#128176; &euro;<%= Number(itin.budgetAmount).toLocaleString() %></span>
                <% if (itin.groupSize) { %><span class="tag">&#128101; <%= t('max') %> <%= itin.groupSize %></span><% } %>
                <% if (itin.ageRange) { %><span class="tag">&#128100; <%= itin.ageRange %></span><% } %>
              </div>
              <a href="/itineraries/<%= itin.id %>" class="btn btn-primary btn-sm btn-block"><%= t('trending_view_trip') %></a>
            </div>
          </div>
        <% }); %>
      </div>
      <div style="text-align: center; margin-top: 48px;">
        <a href="/itineraries" class="btn btn-outline btn-lg"><%= t('trending_browse_all') %></a>
      </div>
    <% } else { %>
      <div style="text-align: center; padding: 48px 0; color: var(--text-light);">
        <p><%= t('trending_no_trips') %></p>
        <a href="/itineraries" class="btn btn-outline" style="margin-top: 16px;"><%= t('nav_browse_trips') %></a>
      </div>
    <% } %>
  </div>
</section>

<!-- How It Works -->
