        <p class="step-desc"><%= t('how_step1_desc') %></p>
      </div>
      <div class="step-arrow">&#10132;</div>
      <div class="step">
        <div class="step-icon">&#128101;</div>
        <div class="step-number">2</div>
        <h3 class="step-title"><%= t('how_step2_title') %></h3>
        <p class="step-desc"><%= t('how_step2_desc') %></p>
      </div>
      <div class="step-arrow">&#10132;</div>
      <div class="step">
        <div class="step-icon">&#128587;</div>
        <div class="step-number">3</div>
        <h3 class="step-title"><%= t('how_step3_title') %></h3>
        <p class="step-desc"><%= t('how_step3_desc') %></p>
      </div>
      <div class="step-arrow">&#10132;</div>
      <div class="step">
        <div class="step-icon">&#128176;</div>
        <div class="step-number">4</div>
        <h3 class="step-title"><%= t('how_step4_title') %></h3>
        <p class="step-desc"><%= t('how_step4_desc') %></p>
      </div>
      <div class="step-arrow">&#10132;</div>
      <div class="step">
        <div class="step-icon">&#127752;</div>
        <div class="step-number">5</div>
        <h3 class="step-title"><%= t('how_step5_title') %></h3>
        <p class="step-desc"><%= t('how_step5_desc') %></p>
      </div>
    </div>
  </div>
</section>

<!-- Features -->
<section class="section features" id="features">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title"><%= t('features_title') %></h2>
      <p class="section-subtitle"><%= t('features_subtitle') %></p>
    </div>
    <div class="features-grid">
      <div class="feature-card">
        <div class="feature-icon">&#128101;</div>
        <h3 class="feature-title"><%= t('features_group_title') %></h3>
        <p class="feature-desc"><%= t('features_group_desc') %></p>
      </div>
      <div class="feature-card">
        <div class="feature-icon">&#128587;</div>
        <h3 class="feature-title"><%= t('features_coordinators_title') %></h3>
        <p class="feature-desc"><%= t('features_coordinators_desc') %></p>
      </div>
      <div class="feature-card">
        <div class="feature-icon">&#128248;</div>
        <h3 class="feature-title"><%= t('features_gallery_title') %></h3>
        <p class="feature-desc"><%= t('features_gallery_desc') %></p>
      </div>
      <div class="feature-card">
        <div class="feature-icon">&#11088;</div>
        <h3 class="feature-title"><%= t('features_reviews_title') %></h3>
        <p class="feature-desc"><%= t('features_reviews_desc') %></p>
      </div>
      <div class="feature-card">
        <div class="feature-icon">&#128293;</div>
        <h3 class="feature-title"><%= t('features_deals_title') %></h3>
        <p class="feature-desc"><%= t('features_deals_desc') %></p>
      </div>
      <div class="feature-card" id="community">
        <div class="feature-icon">&#127760;</div>
        <h3 class="feature-title"><%= t('features_community_title') %></h3>
        <p class="feature-desc"><%= t('features_community_desc') %></p>
      </div>
