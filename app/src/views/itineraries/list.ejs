<%- include('../partials/header') %>

<section class="section">
  <div class="container">
    <h1 class="page-title">Browse Trips</h1>
    <p class="page-subtitle">Explore our curated collection of group travel experiences for every mood and season.</p>

    <!-- Mood/Season Filter Pills -->
    <% const f = typeof filters !== 'undefined' ? filters : {}; %>
    <div class="filter-pills-row" style="margin-bottom: 12px;">
      <span class="filter-pills-label">Mood:</span>
      <a href="/itineraries?mood=adventure<%= f.season ? '&season=' + f.season : '' %><%= f.sort ? '&sort=' + f.sort : '' %>" class="filter-pill <%= f.mood === 'adventure' ? 'filter-pill--active' : '' %>">&#127956; Adventure</a>
      <a href="/itineraries?mood=relaxation<%= f.season ? '&season=' + f.season : '' %><%= f.sort ? '&sort=' + f.sort : '' %>" class="filter-pill <%= f.mood === 'relaxation' ? 'filter-pill--active' : '' %>">&#127796; Relaxation</a>
      <a href="/itineraries?mood=culture<%= f.season ? '&season=' + f.season : '' %><%= f.sort ? '&sort=' + f.sort : '' %>" class="filter-pill <%= f.mood === 'culture' ? 'filter-pill--active' : '' %>">&#127963; Culture</a>
      <a href="/itineraries?mood=party<%= f.season ? '&season=' + f.season : '' %><%= f.sort ? '&sort=' + f.sort : '' %>" class="filter-pill <%= f.mood === 'party' ? 'filter-pill--active' : '' %>">&#127881; Party</a>
      <a href="/itineraries?mood=wellness<%= f.season ? '&season=' + f.season : '' %><%= f.sort ? '&sort=' + f.sort : '' %>" class="filter-pill <%= f.mood === 'wellness' ? 'filter-pill--active' : '' %>">&#128518; Wellness</a>
    </div>
    <div class="filter-pills-row" style="margin-bottom: 20px;">
      <span class="filter-pills-label">Season:</span>
      <a href="/itineraries?season=summer<%= f.mood ? '&mood=' + f.mood : '' %><%= f.sort ? '&sort=' + f.sort : '' %>" class="filter-pill filter-pill--summer <%= f.season === 'summer' ? 'filter-pill--active' : '' %>">&#9728; Summer</a>
      <a href="/itineraries?season=winter<%= f.mood ? '&mood=' + f.mood : '' %><%= f.sort ? '&sort=' + f.sort : '' %>" class="filter-pill filter-pill--winter <%= f.season === 'winter' ? 'filter-pill--active' : '' %>">&#10052; Winter</a>
      <a href="/itineraries?season=spring<%= f.mood ? '&mood=' + f.mood : '' %><%= f.sort ? '&sort=' + f.sort : '' %>" class="filter-pill filter-pill--spring <%= f.season === 'spring' ? 'filter-pill--active' : '' %>">&#127800; Spring</a>
      <a href="/itineraries?season=autumn<%= f.mood ? '&mood=' + f.mood : '' %><%= f.sort ? '&sort=' + f.sort : '' %>" class="filter-pill filter-pill--autumn <%= f.season === 'autumn' ? 'filter-pill--active' : '' %>">&#127810; Autumn</a>
      <% if (f.mood || f.season || f.tag || f.sort) { %>
        <a href="/itineraries" class="filter-pill filter-pill--clear">&#10005; Clear Filters</a>
      <% } %>
    </div>

    <!-- Sort + Advanced Filters -->
    <div class="card" style="margin-bottom: 24px; padding: 20px;">
      <form action="/itineraries" method="GET" style="display: flex; flex-wrap: wrap; gap: 12px; align-items: flex-end;">
        <% if (f.mood) { %><input type="hidden" name="mood" value="<%= f.mood %>"><% } %>
        <% if (f.season) { %><input type="hidden" name="season" value="<%= f.season %>"><% } %>
        <div class="form-group" style="flex: 1; min-width: 140px; margin-bottom: 0;">
          <label class="form-label" style="font-size: 0.8rem; margin-bottom: 4px;">Search</label>
          <input type="text" name="search" class="form-input" placeholder="Destination or title..." value="<%= f.search || '' %>" style="padding: 8px;">
        </div>
        <div class="form-group" style="flex: 0 0 80px; margin-bottom: 0;">
          <label class="form-label" style="font-size: 0.8rem; margin-bottom: 4px;">Country</label>
          <input type="text" name="country" class="form-input" placeholder="CH" maxlength="2" value="<%= f.country || '' %>" style="padding: 8px; text-transform: uppercase;">
        </div>
        <div class="form-group" style="flex: 0 0 80px; margin-bottom: 0;">
          <label class="form-label" style="font-size: 0.8rem; margin-bottom: 4px;">Min Days</label>
          <input type="number" name="min_days" class="form-input" placeholder="1" min="1" value="<%= f.min_days || '' %>" style="padding: 8px;">
        </div>
        <div class="form-group" style="flex: 0 0 80px; margin-bottom: 0;">
          <label class="form-label" style="font-size: 0.8rem; margin-bottom: 4px;">Max Days</label>
          <input type="number" name="max_days" class="form-input" placeholder="30" min="1" value="<%= f.max_days || '' %>" style="padding: 8px;">
        </div>
        <div class="form-group" style="flex: 0 0 140px; margin-bottom: 0;">
          <label class="form-label" style="font-size: 0.8rem; margin-bottom: 4px;">Sort By</label>
          <select name="sort" class="form-input sort-select" style="padding: 8px;">
            <option value="">Default</option>
            <option value="rating" <%= f.sort === 'rating' ? 'selected' : '' %>>Rating (High-Low)</option>
            <option value="price" <%= f.sort === 'price' ? 'selected' : '' %>>Price (Low-High)</option>
            <option value="price_desc" <%= f.sort === 'price_desc' ? 'selected' : '' %>>Price (High-Low)</option>
            <option value="departure" <%= f.sort === 'departure' ? 'selected' : '' %>>Departure (Soonest)</option>
            <option value="discount" <%= f.sort === 'discount' ? 'selected' : '' %>>Biggest Discount</option>
          </select>
        </div>
        <div style="display: flex; gap: 8px; margin-bottom: 0;">
          <button type="submit" class="btn btn-primary" style="padding: 8px 16px;">Filter</button>
          <a href="/itineraries" class="btn btn-outline" style="padding: 8px 16px;">Clear</a>
        </div>
      </form>
    </div>

    <!-- Compare Bar -->
    <div id="compare-bar" style="display: none; position: fixed; bottom: 0; left: 0; right: 0; background: var(--text); color: var(--white); padding: 12px 24px; z-index: 999; box-shadow: 0 -4px 20px rgba(0,0,0,0.2);">
      <div class="container" style="display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap;">
        <span id="compare-count" style="font-weight: 600;">0 <%= t('compare_selected') %></span>
        <div style="display: flex; gap: 8px;">
          <button type="button" id="compare-go-btn" class="btn btn-primary btn-sm" disabled><%= t('compare_btn') %></button>
          <button type="button" id="compare-clear-btn" class="btn btn-outline btn-sm" style="border-color: rgba(255,255,255,0.3); color: var(--white);"><%= t('compare_clear') %></button>
        </div>
      </div>
    </div>

    <div class="card-grid">
      <% const tm = typeof tagsMap !== 'undefined' ? tagsMap : {}; %>
      <% const rm = typeof ratingsMap !== 'undefined' ? ratingsMap : {}; %>
      <% itineraries.forEach(function(itin) { %>
        <div class="card" style="animation: fadeInUp 0.4s ease both; animation-delay: 0s;">
          <div class="card-img-header" style="background: <%= itin.coverGradient || 'linear-gradient(135deg, var(--sky), #d0e8f7)' %>; min-height: 120px;">
            <span class="card-flag"><%= itin.countryCode %></span>
            <span class="tier-badge tier-<%= itin.tier %>" style="position: absolute; top: 8px; right: 8px;"><%= itin.tier.toUpperCase() %></span>
            <% if (itin.discount && itin.discount > 0) { %>
              <span class="deal-badge deal-badge--card" style="position: absolute; top: 8px; left: 8px;">-<%= itin.discount %>%</span>
            <% } %>
            <% if (itin.spotsLeft && itin.spotsLeft <= 5) { %>
              <span class="spots-badge spots-badge--pulse" style="position: absolute; bottom: 8px; right: 8px;"><%= itin.spotsLeft %> spots left!</span>
            <% } %>
          </div>
          <div class="card-body">
            <h3 class="card-title">
              <% if (itin.tier !== 'free' && (!user || (user.plan === 'free' && itin.tier !== 'free') || (user.plan === 'explorer' && itin.tier === 'premium'))) { %>
                <span class="lock-icon">&#128274;</span>
              <% } %>
              <%= itin.title %>
            </h3>
            <div class="card-rating">
              <% const displayRating = rm[itin.id] ? rm[itin.id].avgRating : Number(itin.rating); %>
              <% for (let i = 1; i <= 5; i++) { %>
                <span class="star <%= i <= Math.round(displayRating) ? 'star--filled' : '' %>">&#9733;</span>
              <% } %>
              <span class="rating-text"><%= displayRating ? displayRating.toFixed(1) : (itin.rating || '4.5') %></span>
              <% if (rm[itin.id]) { %>
                <span class="review-count">(<%= rm[itin.id].reviewCount %> reviews)</span>
              <% } %>
            </div>
            <div class="card-meta">
              <span class="meta-item">&#128197; <%= itin.durationDays %> days</span>
              <% if (itin.discount && itin.discount > 0 && itin.originalPrice) { %>
                <span class="meta-item"><span class="price-struck">&euro;<%= Number(itin.originalPrice).toLocaleString() %></span> &euro;<%= Number(itin.budgetAmount).toLocaleString() %></span>
              <% } else { %>
                <span class="meta-item">&#128176; &euro;<%= Number(itin.budgetAmount).toLocaleString() %></span>
              <% } %>
            </div>
            <div class="card-meta" style="margin-top: 4px;">
              <% if (itin.groupSize) { %><span class="meta-item">&#128101; Max <%= itin.groupSize %></span><% } %>
              <% if (itin.ageRange) { %><span class="meta-item">&#128100; <%= itin.ageRange %></span><% } %>
              <% if (itin.departureDate) { %><span class="meta-item">&#128197; <%= new Date(itin.departureDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) %></span><% } %>
            </div>
            <% if (tm[itin.id] && tm[itin.id].length > 0) { %>
              <div class="card-tags">
                <% tm[itin.id].slice(0, 4).forEach(function(tag) { %>
                  <a href="/itineraries?tag=<%= encodeURIComponent(tag) %>" class="tag tag--sm"><%= tag %></a>
                <% }); %>
              </div>
            <% } %>
            <p class="card-desc"><%= itin.description ? itin.description.substring(0, 120) + '...' : '' %></p>
          </div>
          <div class="card-footer" style="display: flex; gap: 8px; align-items: center;">
            <a href="/itineraries/<%= itin.id %>" class="btn btn-primary" style="flex: 1;"><%= t('trending_view_trip') %></a>
            <label style="display: flex; align-items: center; gap: 4px; cursor: pointer; font-size: 0.8rem; color: var(--text-light); white-space: nowrap;" title="<%= t('compare_add') %>">
              <input type="checkbox" class="compare-checkbox" value="<%= itin.id %>" style="width: 16px; height: 16px; cursor: pointer;">
              <%= t('compare_short') %>
            </label>
          </div>
        </div>
      <% }); %>
    </div>

    <script>
    (function() {
      var selected = new Set();
      var bar = document.getElementById('compare-bar');
      var countEl = document.getElementById('compare-count');
      var goBtn = document.getElementById('compare-go-btn');
      var clearBtn = document.getElementById('compare-clear-btn');
      var checks = document.querySelectorAll('.compare-checkbox');

      function update() {
        bar.style.display = selected.size > 0 ? 'block' : 'none';
        countEl.textContent = selected.size + ' selected';
        goBtn.disabled = selected.size < 2;
      }

      checks.forEach(function(cb) {
        cb.addEventListener('change', function() {
          if (cb.checked) {
            if (selected.size >= 3) { cb.checked = false; return; }
            selected.add(cb.value);
          } else {
            selected.delete(cb.value);
          }
          update();
        });
      });

      goBtn.addEventListener('click', function() {
        window.location.href = '/compare?ids=' + Array.from(selected).join(',');
      });

      clearBtn.addEventListener('click', function() {
        selected.clear();
        checks.forEach(function(cb) { cb.checked = false; });
        update();
      });
    })();
    </script>

    <% if (itineraries.length === 0) { %>
      <div class="empty-state">
        <p>No trips match your filters. Try adjusting your search.</p>
        <a href="/itineraries" class="btn btn-outline" style="margin-top: 16px;">Clear Filters</a>
      </div>
    <% } %>
  </div>
</section>

<%- include('../partials/footer') %>
