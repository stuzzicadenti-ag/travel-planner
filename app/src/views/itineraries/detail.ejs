<%- include('../partials/header') %>

<section class="section">
  <div class="container">
    <a href="/itineraries" class="back-link">&larr; Back to Trips</a>

    <% if (typeof error !== 'undefined' && error === 'limit') { %>
      <div class="alert alert-error" style="background: #fef2f2; color: #991b1b; border: 1px solid #fecaca; padding: 12px 16px; border-radius: 8px; margin-bottom: 16px;">
        You have reached the maximum of 3 saved trips on the free plan. Upgrade to save more!
      </div>
    <% } %>

    <!-- Last-Minute Deal Banner -->
    <% if (itinerary.discount && itinerary.discount > 0) { %>
      <div class="deal-banner">
        <span class="deal-banner__badge">&#128293; LAST MINUTE</span>
        <span class="deal-banner__text">Save <%= itinerary.discount %>% on this trip! Limited spots available.</span>
      </div>
    <% } %>

    <!-- Photo Gallery -->
    <% if (typeof photos !== 'undefined' && photos.length > 0) { %>
      <div class="photo-gallery">
        <% photos.forEach(function(photo) { %>
          <div class="photo-gallery__item">
            <div class="photo-gallery__placeholder" style="background: linear-gradient(135deg, #e8f4fd, #b8ddf3);">
              <span class="photo-gallery__caption"><%= photo.caption || 'Trip photo' %></span>
            </div>
          </div>
        <% }); %>
      </div>
    <% } else { %>
      <!-- Colored placeholder cards if no photos -->
      <div class="photo-gallery">
        <div class="photo-gallery__item"><div class="photo-gallery__placeholder" style="background: linear-gradient(135deg, #ffecd2, #fcb69f);"><span class="photo-gallery__caption"><%= itinerary.destination %></span></div></div>
        <div class="photo-gallery__item"><div class="photo-gallery__placeholder" style="background: linear-gradient(135deg, #a1c4fd, #c2e9fb);"><span class="photo-gallery__caption">Day & Night</span></div></div>
        <div class="photo-gallery__item"><div class="photo-gallery__placeholder" style="background: linear-gradient(135deg, #d4fc79, #96e6a1);"><span class="photo-gallery__caption">Nature</span></div></div>
        <div class="photo-gallery__item"><div class="photo-gallery__placeholder" style="background: linear-gradient(135deg, #e0c3fc, #8ec5fc);"><span class="photo-gallery__caption">Culture</span></div></div>
      </div>
    <% } %>

    <div class="detail-layout">
      <div class="detail-main">
        <div class="itinerary-header">
          <div class="itinerary-header-info">
            <span class="tier-badge tier-<%= itinerary.tier %> tier-badge--lg"><%= itinerary.tier.toUpperCase() %></span>
            <h1 class="itinerary-title"><%= itinerary.title %></h1>

            <!-- Average Rating Display -->
            <div class="rating-display">
              <% const displayAvg = typeof avgRating !== 'undefined' && avgRating ? avgRating : Number(itinerary.rating); %>
              <% for (let i = 1; i <= 5; i++) { %>
                <span class="star star--lg <%= i <= Math.round(displayAvg) ? 'star--filled' : '' %>">&#9733;</span>
              <% } %>
              <span class="rating-num-lg"><%= displayAvg ? displayAvg.toFixed(1) : (itinerary.rating || '4.5') %></span>
              <% if (typeof reviewCount !== 'undefined' && reviewCount > 0) { %>
                <span class="review-count-lg">(<%= reviewCount %> review<%= reviewCount !== 1 ? 's' : '' %>)</span>
              <% } %>
            </div>

            <div class="itinerary-meta">
              <span class="meta-item meta-item--lg">&#127758; <%= itinerary.destination %></span>
              <span class="meta-item meta-item--lg">&#128197; <%= itinerary.durationDays %> days</span>
              <% if (itinerary.discount && itinerary.discount > 0 && itinerary.originalPrice) { %>
                <span class="meta-item meta-item--lg"><span class="price-struck">&euro;<%= Number(itinerary.originalPrice).toLocaleString() %></span> &#128176; &euro;<%= Number(itinerary.budgetAmount).toLocaleString() %></span>
              <% } else { %>
                <span class="meta-item meta-item--lg">&#128176; <%= itinerary.budgetCurrency %> <%= Number(itinerary.budgetAmount).toLocaleString() %></span>
              <% } %>
            </div>

            <!-- Tags -->
            <% if (typeof tags !== 'undefined' && tags.length > 0) { %>
              <div class="itinerary-tags">
                <% tags.forEach(function(tag) { %>
                  <span class="tag"><%= tag %></span>
                <% }); %>
              </div>
            <% } %>

            <p class="itinerary-desc"><%= itinerary.description %></p>
          </div>
          <div class="itinerary-actions">
            <% if (user) { %>
              <% if (isSaved) { %>
                <span class="saved-indicator">&#10003; Saved to My Trips</span>
              <% } else { %>
                <form method="POST" action="/itineraries/<%= itinerary.id %>/save">
                  <button type="submit" class="btn btn-orange">&#128278; Save Trip</button>
                </form>
              <% } %>
            <% } else { %>
              <a href="/auth/login" class="btn btn-outline">Login to Save</a>
            <% } %>
            <!-- Share button -->
            <button type="button" class="btn btn-outline btn-sm" style="margin-top: 8px;" onclick="navigator.clipboard.writeText(window.location.href).then(function(){alert('Link copied!')})">&#128279; Share</button>
          </div>
        </div>

        <!-- Group Info Card -->
        <% if (itinerary.coordinatorName || itinerary.groupSize || itinerary.ageRange) { %>
          <div class="group-info-card">
            <h3 class="group-info-title">&#128101; Group Trip Details</h3>
            <div class="group-info-grid">
              <% if (itinerary.coordinatorName) { %>
                <div class="group-info-item">
                  <div class="coordinator-avatar"><%= itinerary.coordinatorName.charAt(0).toUpperCase() %></div>
                  <div>
                    <div class="group-info-label">Your Coordinator</div>
                    <div class="group-info-value"><%= itinerary.coordinatorName %></div>
                    <% if (itinerary.coordinatorBio) { %>
                      <p class="coordinator-bio"><%= itinerary.coordinatorBio %></p>
                    <% } %>
                  </div>
                </div>
              <% } %>
              <% if (itinerary.groupSize) { %>
                <div class="group-info-item">
                  <div class="group-info-icon">&#128101;</div>
                  <div>
                    <div class="group-info-label">Group Size</div>
                    <div class="group-info-value">Max <%= itinerary.groupSize %> travelers</div>
                  </div>
                </div>
              <% } %>
              <% if (itinerary.ageRange) { %>
                <div class="group-info-item">
                  <div class="group-info-icon">&#128100;</div>
                  <div>
                    <div class="group-info-label">Age Range</div>
                    <div class="group-info-value"><%= itinerary.ageRange %></div>
                  </div>
                </div>
              <% } %>
              <% if (itinerary.departureDate) { %>
                <div class="group-info-item">
                  <div class="group-info-icon">&#128197;</div>
                  <div>
                    <div class="group-info-label">Next Departure</div>
                    <div class="group-info-value"><%= new Date(itinerary.departureDate).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }) %></div>
                  </div>
                </div>
              <% } %>
              <% if (itinerary.spotsLeft != null) { %>
                <div class="group-info-item">
                  <div class="group-info-icon"><%= itinerary.spotsLeft <= 3 ? '&#128293;' : '&#127919;' %></div>
                  <div>
                    <div class="group-info-label">Spots Left</div>
                    <div class="group-info-value <%= itinerary.spotsLeft <= 5 ? 'spots-urgent' : '' %>"><%= itinerary.spotsLeft %> spots remaining</div>
                  </div>
                </div>
              <% } %>
            </div>
          </div>
        <% } %>

        <% if (!hasAccess) { %>
          <div class="upgrade-prompt">
            <div class="upgrade-icon">&#128274;</div>
            <h2>Upgrade Required</h2>
            <p>This itinerary requires the <strong><%= itinerary.tier %></strong> plan. Upgrade your account to unlock the full day-by-day details, booking links, and insider tips.</p>
            <a href="/auth/register" class="btn btn-primary btn-lg">Upgrade Now</a>
          </div>
        <% } else { %>
          <div class="timeline">
            <% days.forEach(function(day) { %>
              <div class="timeline-day">
                <div class="timeline-day-header">
                  <span class="day-number">Day <%= day.dayNumber %></span>
                  <h2 class="day-title"><%= day.title %></h2>
                </div>
                <div class="timeline-items">
                  <% day.items.forEach(function(item) { %>
                    <div class="timeline-item">
                      <div class="timeline-time"><%= item.time %></div>
                      <div class="timeline-content">
                        <h3 class="item-title"><%= item.title %></h3>
                        <p class="item-desc"><%= item.description %></p>
                        <% if (item.affiliateUrl && item.partnerName) { %>
                          <form method="POST" action="/itineraries/click/<%= item.id %>" class="affiliate-form">
                            <button type="submit" class="btn btn-affiliate">
                              &#128279; Book via <%= item.partnerName %>
                            </button>
                          </form>
                        <% } %>
                      </div>
                    </div>
                  <% }); %>
                </div>
              </div>
            <% }); %>
          </div>
        <% } %>

        <!-- Weather Widget -->
        <div class="weather-widget" style="margin-top: 32px; background: linear-gradient(135deg, #e0f2fe, #f0f9ff); border: 1px solid var(--border); border-radius: var(--radius); padding: 24px;">
          <h3 style="font-size: 1.15rem; font-weight: 700; margin-bottom: 16px;">&#127326; <%= t('weather_title') %></h3>
          <div id="weather-data" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 16px;">
            <div style="text-align: center; padding: 12px; background: var(--white); border-radius: var(--radius-sm);">
              <div style="font-size: 2rem;" id="weather-icon">&#9729;</div>
              <div style="font-size: 0.8rem; color: var(--text-muted); text-transform: uppercase; font-weight: 600;"><%= t('weather_typical') %></div>
              <div style="font-size: 1.1rem; font-weight: 700;" id="weather-temp">--</div>
            </div>
            <div style="text-align: center; padding: 12px; background: var(--white); border-radius: var(--radius-sm);">
              <div style="font-size: 2rem;">&#127782;</div>
              <div style="font-size: 0.8rem; color: var(--text-muted); text-transform: uppercase; font-weight: 600;"><%= t('weather_rain') %></div>
              <div style="font-size: 1.1rem; font-weight: 700;" id="weather-rain">--</div>
            </div>
            <div style="text-align: center; padding: 12px; background: var(--white); border-radius: var(--radius-sm);">
              <div style="font-size: 2rem;">&#128197;</div>
              <div style="font-size: 0.8rem; color: var(--text-muted); text-transform: uppercase; font-weight: 600;"><%= t('weather_best_time') %></div>
              <div style="font-size: 1.1rem; font-weight: 700;" id="weather-best"><%= itinerary.season ? (t('filter_' + itinerary.season) || itinerary.season) : '--' %></div>
            </div>
          </div>
          <script>
          (function() {
            // Hardcoded seasonal climate data by country code
            var climateData = {
              'IT': { temp: '15-28', rain: '25%', icon: '&#9728;', best: 'spring' },
              'JP': { temp: '10-30', rain: '35%', icon: '&#127800;', best: 'spring' },
              'TH': { temp: '25-35', rain: '40%', icon: '&#9728;', best: 'winter' },
              'GR': { temp: '15-32', rain: '15%', icon: '&#9728;', best: 'summer' },
              'IS': { temp: '-2-15', rain: '45%', icon: '&#10052;', best: 'summer' },
              'PE': { temp: '10-25', rain: '30%', icon: '&#9925;', best: 'winter' },
              'FR': { temp: '8-25', rain: '30%', icon: '&#9925;', best: 'summer' },
              'ES': { temp: '12-30', rain: '20%', icon: '&#9728;', best: 'spring' },
              'US': { temp: '5-30', rain: '30%', icon: '&#9925;', best: 'autumn' },
              'GB': { temp: '5-22', rain: '45%', icon: '&#127782;', best: 'summer' },
              'DE': { temp: '2-25', rain: '35%', icon: '&#9925;', best: 'summer' },
              'CH': { temp: '0-25', rain: '35%', icon: '&#9925;', best: 'summer' },
              'PT': { temp: '12-28', rain: '20%', icon: '&#9728;', best: 'spring' },
              'AU': { temp: '15-30', rain: '25%', icon: '&#9728;', best: 'spring' },
              'BR': { temp: '20-32', rain: '40%', icon: '&#9728;', best: 'winter' },
              'MX': { temp: '18-30', rain: '35%', icon: '&#9728;', best: 'winter' },
              'IN': { temp: '20-35', rain: '45%', icon: '&#9728;', best: 'winter' },
              'ID': { temp: '25-33', rain: '50%', icon: '&#127782;', best: 'summer' },
              'MA': { temp: '12-30', rain: '20%', icon: '&#9728;', best: 'spring' },
              'ZA': { temp: '10-28', rain: '25%', icon: '&#9728;', best: 'spring' },
              'HR': { temp: '8-28', rain: '25%', icon: '&#9728;', best: 'summer' },
              'TR': { temp: '8-30', rain: '25%', icon: '&#9728;', best: 'spring' },
              'EG': { temp: '15-38', rain: '5%', icon: '&#9728;', best: 'winter' },
              'VN': { temp: '22-33', rain: '45%', icon: '&#9728;', best: 'winter' },
              'NZ': { temp: '8-22', rain: '35%', icon: '&#9925;', best: 'summer' },
              'CO': { temp: '18-28', rain: '40%', icon: '&#127782;', best: 'winter' },
              'KE': { temp: '15-28', rain: '30%', icon: '&#9728;', best: 'winter' },
              'NO': { temp: '-5-20', rain: '40%', icon: '&#10052;', best: 'summer' },
              'SE': { temp: '-5-22', rain: '35%', icon: '&#10052;', best: 'summer' },
            };
            var cc = '<%= itinerary.countryCode %>';
            var data = climateData[cc] || { temp: '10-25', rain: '30%', icon: '&#9925;', best: '--' };
            var seasonNames = {
              'spring': '<%= t("filter_spring") %>',
              'summer': '<%= t("filter_summer") %>',
              'autumn': '<%= t("filter_autumn") %>',
              'winter': '<%= t("filter_winter") %>'
            };
            document.getElementById('weather-icon').innerHTML = data.icon;
            document.getElementById('weather-temp').textContent = data.temp + ' \u00B0C';
            document.getElementById('weather-rain').textContent = data.rain;
            var bestEl = document.getElementById('weather-best');
            if (data.best !== '--') bestEl.textContent = seasonNames[data.best] || data.best;
          })();
          </script>
        </div>

        <!-- Cost Estimator -->
        <div class="cost-estimator" style="margin-top: 32px; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 24px;">
          <h3 style="font-size: 1.15rem; font-weight: 700; margin-bottom: 16px;">&#128178; <%= t('cost_title') %></h3>
          <p style="font-size: 0.9rem; color: var(--text-light); margin-bottom: 16px;"><%= t('cost_subtitle') %></p>
          <div style="display: flex; flex-wrap: wrap; gap: 16px; margin-bottom: 20px;">
            <div class="form-group" style="flex: 1; min-width: 120px; margin-bottom: 0;">
              <label class="form-label" style="font-size: 0.8rem;"><%= t('cost_travelers') %></label>
              <input type="number" id="cost-travelers" class="form-input" value="2" min="1" max="20" style="padding: 8px;">
            </div>
            <div class="form-group" style="flex: 1; min-width: 140px; margin-bottom: 0;">
              <label class="form-label" style="font-size: 0.8rem;"><%= t('cost_hotel_tier') %></label>
              <select id="cost-hotel" class="form-input" style="padding: 8px;">
                <option value="budget"><%= t('cost_budget') %></option>
                <option value="mid" selected><%= t('cost_mid') %></option>
                <option value="luxury"><%= t('cost_luxury') %></option>
              </select>
            </div>
            <div class="form-group" style="flex: 1; min-width: 140px; margin-bottom: 0;">
              <label class="form-label" style="font-size: 0.8rem;"><%= t('cost_include_flights') %></label>
              <select id="cost-flights" class="form-input" style="padding: 8px;">
                <option value="yes"><%= t('cost_yes') %></option>
                <option value="no"><%= t('cost_no') %></option>
              </select>
            </div>
            <div style="display: flex; align-items: flex-end;">
              <button type="button" id="cost-calc-btn" class="btn btn-primary" style="padding: 8px 20px;"><%= t('cost_calculate') %></button>
            </div>
          </div>

          <div id="cost-result" style="display: none;">
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 12px; margin-bottom: 16px;">
              <div style="background: var(--sky); padding: 12px; border-radius: var(--radius-sm); text-align: center;">
                <div style="font-size: 0.75rem; color: var(--text-muted); font-weight: 600; text-transform: uppercase;"><%= t('cost_flights_label') %></div>
                <div id="cost-flights-val" style="font-size: 1.1rem; font-weight: 700;">-</div>
              </div>
              <div style="background: var(--sky); padding: 12px; border-radius: var(--radius-sm); text-align: center;">
                <div style="font-size: 0.75rem; color: var(--text-muted); font-weight: 600; text-transform: uppercase;"><%= t('cost_accommodation_label') %></div>
                <div id="cost-hotel-val" style="font-size: 1.1rem; font-weight: 700;">-</div>
              </div>
              <div style="background: var(--sky); padding: 12px; border-radius: var(--radius-sm); text-align: center;">
                <div style="font-size: 0.75rem; color: var(--text-muted); font-weight: 600; text-transform: uppercase;"><%= t('cost_activities_label') %></div>
                <div id="cost-activities-val" style="font-size: 1.1rem; font-weight: 700;">-</div>
              </div>
              <div style="background: var(--sky); padding: 12px; border-radius: var(--radius-sm); text-align: center;">
                <div style="font-size: 0.75rem; color: var(--text-muted); font-weight: 600; text-transform: uppercase;"><%= t('cost_food_label') %></div>
                <div id="cost-food-val" style="font-size: 1.1rem; font-weight: 700;">-</div>
              </div>
              <div style="background: var(--sky); padding: 12px; border-radius: var(--radius-sm); text-align: center;">
                <div style="font-size: 0.75rem; color: var(--text-muted); font-weight: 600; text-transform: uppercase;"><%= t('cost_transport_label') %></div>
                <div id="cost-transport-val" style="font-size: 1.1rem; font-weight: 700;">-</div>
              </div>
            </div>
            <div style="background: linear-gradient(135deg, var(--blue), var(--blue-dark)); color: var(--white); padding: 16px 24px; border-radius: var(--radius-sm); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
              <span style="font-size: 1rem; font-weight: 600;"><%= t('cost_total') %></span>
              <span id="cost-total-val" style="font-size: 1.5rem; font-weight: 800;">-</span>
            </div>
            <p style="font-size: 0.8rem; color: var(--text-muted); margin-top: 8px; text-align: center;"><%= t('cost_disclaimer') %></p>
          </div>

          <script>
          (function() {
            var duration = <%= itinerary.durationDays %>;
            var currency = '<%= itinerary.budgetCurrency %>';
            var baseBudget = <%= Number(itinerary.budgetAmount) %>;
            // Use base budget as fallback for cost estimates
            var flightBase = Math.round(baseBudget * 0.25);
            var budgetHotel = Math.round(baseBudget * 0.08);
            var midHotel = Math.round(baseBudget * 0.15);
            var luxuryHotel = Math.round(baseBudget * 0.30);
            var activitiesBase = Math.round(baseBudget * 0.20);
            var foodPerDay = Math.round(baseBudget * 0.05);
            var transportPerDay = Math.round(baseBudget * 0.03);

            function fmt(n) { return currency + ' ' + n.toLocaleString(); }

            document.getElementById('cost-calc-btn').addEventListener('click', function() {
              var travelers = Math.max(1, Math.min(20, parseInt(document.getElementById('cost-travelers').value) || 2));
              var hotelTier = document.getElementById('cost-hotel').value;
              var includeFlights = document.getElementById('cost-flights').value === 'yes';

              var nights = Math.max(1, duration - 1);
              var hotelRate = hotelTier === 'budget' ? budgetHotel : (hotelTier === 'luxury' ? luxuryHotel : midHotel);

              var flightTotal = includeFlights ? flightBase * travelers : 0;
              var hotelTotal = hotelRate * nights * Math.ceil(travelers / 2); // sharing rooms
              var activitiesTotal = activitiesBase * travelers;
              var foodTotal = foodPerDay * duration * travelers;
              var transportTotal = transportPerDay * duration * travelers;
              var total = flightTotal + hotelTotal + activitiesTotal + foodTotal + transportTotal;

              document.getElementById('cost-flights-val').textContent = includeFlights ? fmt(flightTotal) : '-';
              document.getElementById('cost-hotel-val').textContent = fmt(hotelTotal);
              document.getElementById('cost-activities-val').textContent = fmt(activitiesTotal);
              document.getElementById('cost-food-val').textContent = fmt(foodTotal);
              document.getElementById('cost-transport-val').textContent = fmt(transportTotal);
              document.getElementById('cost-total-val').textContent = fmt(total);
              document.getElementById('cost-result').style.display = 'block';
            });
          })();
          </script>
        </div>

        <!-- Trip Reports Link -->
        <div style="margin-top: 24px;">
          <a href="/journals/itinerary/<%= itinerary.id %>" class="btn btn-outline" style="padding: 8px 20px;">&#128221; <%= t('journals_read_reports') %></a>
        </div>

        <!-- Reviews Section -->
        <div class="reviews-section">
          <h2 class="reviews-title">&#11088; Reviews</h2>

          <% if (typeof reviewError !== 'undefined' && reviewError === 'invalid_rating') { %>
            <div class="alert alert-error" style="margin-bottom: 16px;">Rating must be between 1 and 5.</div>
          <% } %>
          <% if (typeof reviewError !== 'undefined' && reviewError === 'already_reviewed') { %>
            <div class="alert alert-error" style="margin-bottom: 16px;">You have already reviewed this trip.</div>
          <% } %>

          <!-- Write a Review Form -->
          <% if (user && typeof userReviewed !== 'undefined' && !userReviewed) { %>
            <div class="review-form-card">
              <h3>Write a Review</h3>
              <form method="POST" action="/itineraries/<%= itinerary.id %>/review" class="review-form">
                <div class="form-group">
                  <label class="form-label">Rating</label>
                  <div class="rating-input">
                    <% for (let i = 5; i >= 1; i--) { %>
                      <input type="radio" name="rating" id="star<%= i %>" value="<%= i %>" required>
                      <label for="star<%= i %>" class="rating-input__star">&#9733;</label>
                    <% } %>
                  </div>
                </div>
                <div class="form-group">
                  <label class="form-label">Comment (optional, max 1000 chars)</label>
                  <textarea name="comment" class="form-input" maxlength="1000" rows="3" placeholder="Share your experience..."></textarea>
                </div>
                <button type="submit" class="btn btn-primary">Submit Review</button>
              </form>
            </div>
          <% } else if (!user) { %>
            <p style="margin-bottom: 16px; color: var(--text-light);"><a href="/auth/login">Login</a> to write a review.</p>
          <% } %>

          <!-- Reviews List -->
          <% if (typeof reviews !== 'undefined' && reviews.length > 0) { %>
            <div class="reviews-list">
              <% reviews.forEach(function(rev) { %>
                <div class="review-card">
                  <div class="review-card__header">
                    <div class="review-avatar"><%= rev.user_name ? rev.user_name.charAt(0).toUpperCase() : '?' %></div>
                    <div class="review-info">
                      <span class="review-name"><%= rev.user_name %></span>
                      <span class="review-date"><%= new Date(rev.created_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></span>
                    </div>
                  </div>
                  <div class="review-stars">
                    <% for (let i = 1; i <= 5; i++) { %>
                      <span class="star <%= i <= rev.rating ? 'star--filled' : '' %>">&#9733;</span>
                    <% } %>
                  </div>
                  <% if (rev.comment) { %>
                    <p class="review-comment"><%= rev.comment %></p>
                  <% } %>
                </div>
              <% }); %>
            </div>
          <% } else { %>
            <p class="no-reviews">No reviews yet. Be the first to share your experience!</p>
          <% } %>
        </div>
      </div>
    </div>

    <!-- Related Itineraries -->
    <% if (typeof related !== 'undefined' && related.length > 0) { %>
      <div class="related-section">
        <h2 class="section-title" style="text-align: left; margin-bottom: 24px;">You Might Also Like</h2>
        <div class="related-grid">
          <% related.forEach(function(rel) { %>
            <div class="card">
              <div class="card-header" style="background: <%= rel.cover_gradient || 'var(--sky)' %>; min-height: 80px; align-items: center; justify-content: center; position: relative;">
                <span class="card-flag" style="font-size: 1.5rem;"><%= rel.country_code %></span>
                <% if (rel.discount && rel.discount > 0) { %>
                  <span class="deal-badge deal-badge--card" style="position: absolute; top: 8px; left: 8px;">-<%= rel.discount %>%</span>
                <% } %>
              </div>
              <div class="card-body">
                <h3 class="card-title"><%= rel.title %></h3>
                <div class="card-meta">
                  <span class="meta-item">&#128197; <%= rel.duration_days %> days</span>
                  <span class="meta-item">&#128176; &euro;<%= Number(rel.budget_amount).toLocaleString() %></span>
                  <span class="meta-item">&#11088; <%= rel.rating %></span>
                </div>
              </div>
              <div class="card-footer">
                <a href="/itineraries/<%= rel.id %>" class="btn btn-primary btn-block">View Trip</a>
              </div>
            </div>
          <% }); %>
        </div>
      </div>
    <% } %>
  </div>
</section>

<%- include('../partials/footer') %>
