<%- include('partials/header') %>

<section class="section">
  <div class="container" style="max-width: 800px;">
    <h1 class="page-title" style="text-align: center;"><%= t('faq_title') %></h1>
    <p class="page-subtitle" style="text-align: center;"><%= t('faq_subtitle') %></p>

    <div style="display: flex; flex-direction: column; gap: 2rem; margin-top: 2rem;">

      <!-- How TravelPlanner Works -->
      <div class="card" style="padding: 1.5rem;">
        <h2 style="font-size: 1.25rem; font-weight: 700; margin-bottom: 0.75rem; color: #2c3e50;"><%= t('faq_how_title') %></h2>
        <p style="color: #5a6d7e; line-height: 1.7;"><%= t('faq_how_desc') %></p>
      </div>

      <!-- Creating & Sharing Itineraries -->
      <div class="card" style="padding: 1.5rem;">
        <h2 style="font-size: 1.25rem; font-weight: 700; margin-bottom: 0.75rem; color: #2c3e50;"><%= t('faq_creating_title') %></h2>
        <p style="color: #5a6d7e; line-height: 1.7;"><%= t('faq_creating_desc') %></p>
      </div>

      <!-- Saving Trips -->
      <div class="card" style="padding: 1.5rem;">
        <h2 style="font-size: 1.25rem; font-weight: 700; margin-bottom: 0.75rem; color: #2c3e50;"><%= t('faq_saving_title') %></h2>
        <p style="color: #5a6d7e; line-height: 1.7;"><%= t('faq_saving_desc') %></p>
      </div>

      <!-- Community Guidelines -->
      <div class="card" style="padding: 1.5rem;">
        <h2 style="font-size: 1.25rem; font-weight: 700; margin-bottom: 0.75rem; color: #2c3e50;"><%= t('faq_community_title') %></h2>
        <p style="color: #5a6d7e; line-height: 1.7; margin-bottom: 0.75rem;"><%= t('faq_community_desc') %></p>
        <ul style="color: #5a6d7e; line-height: 2; padding-left: 1.25rem;">
          <li><strong><%= t('faq_community_rule1') %></strong></li>
          <li><strong><%= t('faq_community_rule2') %></strong></li>
          <li><strong><%= t('faq_community_rule3') %></strong></li>
          <li><strong><%= t('faq_community_rule4') %></strong></li>
          <li><strong><%= t('faq_community_rule5') %></strong></li>
        </ul>
        <p style="color: #5a6d7e; line-height: 1.7; margin-top: 0.75rem;"><%= t('faq_community_violations') %></p>
      </div>

      <!-- Account Rules -->
      <div class="card" style="padding: 1.5rem;">
        <h2 style="font-size: 1.25rem; font-weight: 700; margin-bottom: 0.75rem; color: #2c3e50;"><%= t('faq_account_title') %></h2>
        <ul style="color: #5a6d7e; line-height: 2; padding-left: 1.25rem;">
          <li><%= t('faq_account_rule1') %></li>
          <li><%= t('faq_account_rule2') %></li>
          <li><%= t('faq_account_rule3') %></li>
          <li><%= t('faq_account_rule4') %></li>
        </ul>
      </div>

      <!-- Swiss Regulations -->
      <div class="card" style="padding: 1.5rem;">
        <h2 style="font-size: 1.25rem; font-weight: 700; margin-bottom: 0.75rem; color: #2c3e50;"><%= t('faq_swiss_title') %></h2>
        <p style="color: #5a6d7e; line-height: 1.7; margin-bottom: 0.75rem;"><%= t('faq_swiss_desc') %></p>
        <ul style="color: #5a6d7e; line-height: 2; padding-left: 1.25rem;">
          <li><%= t('faq_swiss_rule1') %></li>
          <li><%= t('faq_swiss_rule2') %></li>
          <li><%= t('faq_swiss_rule3') %></li>
          <li><%= t('faq_swiss_rule4') %></li>
          <li><%= t('faq_swiss_rule5') %></li>
        </ul>
      </div>

      <!-- Contact -->
      <div class="card" style="padding: 1.5rem; text-align: center; background: linear-gradient(135deg, #e8f4fd 0%, #fde8c8 100%);">
        <h2 style="font-size: 1.25rem; font-weight: 700; margin-bottom: 0.75rem; color: #2c3e50;"><%= t('faq_help_title') %></h2>
        <p style="color: #5a6d7e; line-height: 1.7; margin-bottom: 1rem;"><%= t('faq_help_desc') %></p>
        <a href="mailto:support@travelplanner.ch" class="btn btn-primary btn-lg">support@travelplanner.ch</a>
      </div>

    </div>
  </div>
</section>

<%- include('partials/footer') %>
