  </main>

  <!-- Newsletter Section -->
  <section class="newsletter-section">
    <div class="container">
      <div class="newsletter-inner">
        <div class="newsletter-text">
          <h3><%= typeof t !== 'undefined' ? t('newsletter_title') : 'Get exclusive deals & travel inspiration' %></h3>
          <p><%= typeof t !== 'undefined' ? t('newsletter_subtitle') : 'Join 10,000+ travelers. Weekly curated trips, last-minute deals, and community stories.' %></p>
        </div>
        <form class="newsletter-form" action="/newsletter/subscribe" method="POST" id="newsletter-form">
          <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
          <input type="email" name="email" class="newsletter-input" placeholder="<%= typeof t !== 'undefined' ? t('newsletter_placeholder') : 'Enter your email' %>" required maxlength="255" autocomplete="email">
          <button type="submit" class="btn btn-primary newsletter-btn" id="newsletter-btn"><%= typeof t !== 'undefined' ? t('newsletter_subscribe') : 'Subscribe' %></button>
        </form>
        <script>
        (function() {
          var form = document.getElementById('newsletter-form');
          var btn = document.getElementById('newsletter-btn');
          if (form && btn) {
            form.addEventListener('submit', function() {
              btn.classList.add('btn--loading');
              btn.textContent = '...';
            });
          }
        })();
        </script>
      </div>
    </div>
  </section>

