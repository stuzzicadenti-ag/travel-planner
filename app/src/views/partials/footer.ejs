  <!-- Scroll to top button -->
  <button type="button" id="scroll-top-btn" aria-label="Scroll to top" style="position: fixed; bottom: 24px; right: 24px; width: 48px; height: 48px; border-radius: 50%; background: linear-gradient(135deg, var(--blue), #5bb8e8); color: var(--white); border: none; cursor: pointer; box-shadow: 0 4px 20px rgba(58,155,213,0.35); z-index: 999; font-size: 1.2rem; display: none; align-items: center; justify-content: center; transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); backdrop-filter: blur(8px);">&#8593;</button>

  <script>
    // Navbar scroll effect
    var navEl = document.getElementById('navbar');
    if (navEl) {
      window.addEventListener('scroll', function() {
        navEl.classList.toggle('scrolled', window.scrollY > 50);
      }, { passive: true });
    }

    // Scroll to top button
    var scrollBtn = document.getElementById('scroll-top-btn');
    if (scrollBtn) {
      window.addEventListener('scroll', function() {
        if (window.scrollY > 400) {
          scrollBtn.style.display = 'flex';
          scrollBtn.style.opacity = '1';
          scrollBtn.style.transform = 'scale(1)';
        } else {
          scrollBtn.style.opacity = '0';
          scrollBtn.style.transform = 'scale(0.8)';
          setTimeout(function() { if (window.scrollY <= 400) scrollBtn.style.display = 'none'; }, 250);
        }
      }, { passive: true });
      scrollBtn.addEventListener('click', function() {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    }

    // Close mobile nav on link click
    var navToggle = document.getElementById('nav-toggle');
    if (navToggle) {
      document.querySelectorAll('.nav-links .nav-link').forEach(function(link) {
        link.addEventListener('click', function() {
          navToggle.checked = false;
        });
      });
    }

    // Section fade-in on scroll (Intersection Observer)
    if ('IntersectionObserver' in window) {
      var sectionObs = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add('in-view');
            sectionObs.unobserve(entry.target);
          }
        });
      }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });
      document.querySelectorAll('.section').forEach(function(sec) {
        sec.classList.add('section-animate');
        sectionObs.observe(sec);
      });
    }

    // Button ripple/glow effect on hover
    document.querySelectorAll('.btn').forEach(function(btn) {
      btn.addEventListener('mousemove', function(e) {
        var rect = btn.getBoundingClientRect();
        btn.style.setProperty('--x', ((e.clientX - rect.left) / rect.width * 100) + '%');
        btn.style.setProperty('--y', ((e.clientY - rect.top) / rect.height * 100) + '%');
      });
    });

    // Scroll-to-top hover effect
    if (scrollBtn) {
      scrollBtn.addEventListener('mouseenter', function() {
        scrollBtn.style.transform = 'scale(1.1)';
        scrollBtn.style.boxShadow = '0 6px 28px rgba(58,155,213,0.45)';
      });
      scrollBtn.addEventListener('mouseleave', function() {
        scrollBtn.style.transform = 'scale(1)';
        scrollBtn.style.boxShadow = '0 4px 20px rgba(58,155,213,0.35)';
      });
    }
  </script>

  <!-- Auto-inject CSRF token into all POST forms that don't already have one -->
  <script>
  (function() {
    var token = '<%= typeof csrfToken !== "undefined" ? csrfToken : "" %>';
    if (!token) return;
    document.querySelectorAll('form[method="POST"], form[method="post"]').forEach(function(form) {
      if (form.querySelector('input[name="_csrf"]')) return;
      var input = document.createElement('input');
      input.type = 'hidden';
      input.name = '_csrf';
      input.value = token;
      form.appendChild(input);
    });
  })();
  </script>
</body>
</html>
