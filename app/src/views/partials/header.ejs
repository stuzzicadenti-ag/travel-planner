<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>TravelPlanner - Plan. Explore. Remember.</title>
  <meta name="description" content="TravelPlanner is a WeRoad-style group travel platform. Discover curated group trips, read reviews, find last-minute deals, and join a community of travelers.">
  <link rel="icon" type="image/svg+xml" href="/public/favicon.svg">
  <link rel="stylesheet" href="/public/style.css">
  <link rel="stylesheet" href="/public/landing.css">
</head>
<body>

  <nav class="navbar" id="navbar">
    <div class="container nav-container">
      <a href="/" class="nav-brand">
        <span class="nav-icon">&#9992;</span>
        TravelPlanner
      </a>
      <input type="checkbox" id="nav-toggle" class="nav-toggle-checkbox" aria-label="Toggle navigation">
      <label for="nav-toggle" class="nav-toggle-label" aria-label="Menu">
        <span></span><span></span><span></span>
      </label>
      <ul class="nav-links">
        <li><a href="/" class="nav-link active">Home</a></li>
        <li><a href="/itineraries" class="nav-link">Browse Trips</a></li>
        <li><a href="/community" class="nav-link">Community</a></li>
        <% if (typeof user !== 'undefined' && user) { %>
          <li><a href="/trips" class="nav-link">My Trips</a></li>
        <% } %>
        <li><a href="#partners" class="nav-link">Partners</a></li>
        <li><a href="#pricing" class="nav-link">Pricing</a></li>
        <li><a href="/faq" class="nav-link">FAQ</a></li>
        <% if (typeof user !== 'undefined' && user && (user.role === 'admin' || user.role === 'owner')) { %>
          <li><a href="/admin" class="nav-link" style="color: #f5a623; font-weight: 700;">Admin</a></li>
        <% } %>
      </ul>
      <div class="nav-actions">
        <% if (typeof user !== 'undefined' && user) { %>
          <span class="nav-user">
            <span class="plan-badge plan-<%= user.plan %>"><%= user.plan %></span>
            <%= user.name %>
          </span>
          <a href="/auth/logout" class="btn btn-ghost">Logout</a>
        <% } else { %>
          <a href="/auth/login" class="btn btn-ghost">Login</a>
          <a href="/auth/register" class="btn btn-primary btn-sm">Register</a>
        <% } %>
      </div>
    </div>
  </nav>

  <main class="main-content">
