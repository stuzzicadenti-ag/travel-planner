<%- include('../partials/header') %>

<section class="section">
  <div class="container container--narrow">
    <div class="auth-card">
      <h1 class="auth-title"><%= t('auth_create_account') %></h1>
      <p class="auth-subtitle"><%= t('auth_register_subtitle') %></p>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-error"><%= error %></div>
      <% } %>

      <form method="POST" action="/auth/register" class="auth-form">
        <div class="form-group">
          <label for="name" class="form-label"><%= t('auth_full_name') %></label>
          <input type="text" id="name" name="name" class="form-input" placeholder="<%= t('auth_name_placeholder') %>" required>
        </div>
        <div class="form-group">
          <label for="email" class="form-label"><%= t('auth_email') %></label>
          <input type="email" id="email" name="email" class="form-input" placeholder="<%= t('auth_email_placeholder') %>" required>
        </div>
        <div class="form-group">
          <label for="password" class="form-label"><%= t('auth_password') %></label>
          <input type="password" id="password" name="password" class="form-input" placeholder="<%= t('auth_password_register_placeholder') %>" required minlength="8">
        </div>
        <button type="submit" class="btn btn-primary btn-block btn-lg"><%= t('auth_create_account_btn') %></button>
      </form>

      <p class="auth-switch"><%= t('auth_has_account') %> <a href="/auth/login"><%= t('auth_login_here') %></a></p>
    </div>
  </div>
</section>

<%- include('../partials/footer') %>
