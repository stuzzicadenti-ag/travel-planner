<%- include('../partials/header') %>

<section class="section">
  <div class="container container--narrow">
    <div class="auth-card">
      <h1 class="auth-title"><%= t('auth_welcome_back') %></h1>
      <p class="auth-subtitle"><%= t('auth_login_subtitle') %></p>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-error"><%= error %></div>
      <% } %>

      <form method="POST" action="/auth/login" class="auth-form" id="login-form">
        <div class="form-group">
          <label for="email" class="form-label"><%= t('auth_email') %></label>
          <input type="email" id="email" name="email" class="form-input" placeholder="<%= t('auth_email_placeholder') %>" required autocomplete="email">
        </div>
        <div class="form-group">
          <label for="password" class="form-label"><%= t('auth_password') %></label>
          <div class="password-wrapper">
            <input type="password" id="password" name="password" class="form-input" style="padding-right: 40px;" placeholder="<%= t('auth_password_placeholder') %>" required autocomplete="current-password">
            <button type="button" class="password-toggle" aria-label="Toggle password visibility" onclick="var p=document.getElementById('password');if(p.type==='password'){p.type='text';this.textContent='&#128584;'}else{p.type='password';this.textContent='&#128065;'}">&#128065;</button>
          </div>
        </div>
        <button type="submit" class="btn btn-primary btn-block btn-lg" id="login-btn"><%= t('auth_login_btn') %></button>
      </form>

      <p class="auth-switch"><%= t('auth_no_account') %> <a href="/auth/register"><%= t('auth_register_here') %></a></p>
    </div>
  </div>
</section>

<script>
(function() {
  var form = document.getElementById('login-form');
  var btn = document.getElementById('login-btn');
  if (form && btn) {
    form.addEventListener('submit', function() {
      btn.classList.add('btn--loading');
      btn.textContent = '<%= typeof t !== "undefined" ? t("auth_logging_in") : "Logging in..." %>';
    });
  }
})();
</script>

<%- include('../partials/footer') %>
